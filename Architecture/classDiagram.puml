@startuml classDiagram

class Timer {
    -timeLeft : float
    -isRunning : boolean
    +update(delta)
    +render(SpriteBatch)
    +pause()
    +resume()
    +dispose()
}

Screen <|-- Timer

'Screen
abstract class Screen {
    game : Game
    render()
}

class InstructionScreen {
    instructionText : String
    backButton : Button
    showInstructions()
}

class PauseScreen {
    resumeButton : Button
    quitButton : Button
    showMenu()
}

class HomeScreen {
    startButton : Button
    musicButton : Button
    soundButton : Button
    wardrobeButton : Button
    openScreen(Screen nextScreen)
}

class CharacterCustomisationScreen {
   +availableHeadSkins: Array<Texture>
   +availableBodySkins: Array<Texture>
   -player: Player
   -selectedHeadIndex: int
   -selectedBodyIndex: int
   -confirmButton: Button
   -applySkin()
}

class MapScreen {
    -showMapScreen()
    +closeMapScreen
    -traverseMap()
}

Map o-- MapScreen

Screen <|-- InstructionScreen
Screen <|-- PauseScreen
Screen <|-- HomeScreen
Screen <|-- CharacterCustomisationScreen
Screen <|-- MapScreen
Screen *-- Button

Player <-- CharacterCustomisationScreen

'Button
class Button {
    bounds : Rectangle
    isPressed : Boolean
    onClick()
}

class Player {
    -position : Vector2
    -speed: float
    -energy: Energy
    -inventory: Inventory
    head: CharacterElement
    body: CharacterElement
    +getInventory()
    +getEnergy()
    +setSpeed()
    +getSpeed()
    +getPosition()
    +setPosition()
    +move()
    +handle_input()
    +render()
    +dispose()
}

class Energy {
    -currentEnergy : float
    -maxEnergy : float
    -regenerationRate: float
    -lowThreshold: float
    +getCurrentEnergy()
    +addEnergy()
    +subtractEnergy()
}

Player *-- Energy

class Inventory {
    - items: Item[]
    + getItems()
    + addItem(Item)
    + removeItem(Item)
}

Inventory *.. Item
Player o-- Inventory

class CharacterElement {
    +sprite
    -type: CharacterElementType
}

enum CharacterElementType {
    HEAD
    BODY
}

CharacterElement --> CharacterElementType
Player *-- CharacterElement


'Room
class Room {
    background : Texture
    -left: Door | null
    -right: Door | null
    -up: Door | null
    -down: Door | null
    +getLeftDoor()
    +getRightDoor()
    +getUpDoor()
    +getDownDoor()
    +render()
}

Room o-- Obstacle

class Door {
    +currentRoom: Room
    +targetRoom: Room
}

Room *-- Door
Room --* Door
Obstacle <|.. Door

'Event
interface Event {
    position : Vector2
    triggered : boolean
    id : string
}

class Item {
    itemId : String
    icon : TextureRegion
    pickupSound : Sound
    type: ItemType
}

enum ItemType {
    CONSUMABLE
    PICKUP
}

Item --> ItemType

interface Obstacle {
    collisionBox : Rectangle
    sprite: Sprite
    solid: boolean
}

Obstacle <|.. Item
Event <|-- Obstacle
Obstacle <|.. Map
Obstacle <|.. Enemy

class Map {
    showMapScreen()
}

'Hidden Event
abstract class HiddenEvent {
    isRevealed : boolean
    activate()
}

Event <|-- HiddenEvent

class LongBoiSpirit {
    appearanceTime : float
}

class PowerCut {
    duration : float
    powerRestored : boolean
}

HiddenEvent <|-- LongBoiSpirit
HiddenEvent <|-- PowerCut

@enduml

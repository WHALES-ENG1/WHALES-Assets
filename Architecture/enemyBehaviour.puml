@startuml EnemyBehaviour

actor Player #Red

loop Roaming
    Enemy -> Enemy: Move to new location in room
    Enemy -> Player: Check if player is nearby
    alt Player close to Enemy & Doesn't have distraction item
        Enemy -> Enemy: Move towards player
        alt Enemy touches player
            Enemy -> Player: Reduce energy
            Enemy -> Player: Knock back player
            Enemy -> Enemy: Move away from player
        end
    end
end

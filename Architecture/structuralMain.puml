@startuml structuralDiagram

'Diagram for main menu? i.e. settings leaderboard'

actor Player #Red

'start of the game'

Player -> Engine: Start game
Engine -> Timer: Start 5 Min timer
Timer -> Engine: Render timer


'creation of the maze

Engine -> Enemy: Initialise enemies
Engine -> Item: Initialise game obstacles
Engine -> Player: Initialise full energy
Player -> Energy: Create energy bar

'items:'

Player -> Item: Interact with Item
alt Item is non-consumable
    Item -> Player: Item moves to inventory
    Item -> Engine: Remove item from the screen
else Item is consumable
    Engine -> Item: Player consumes the item
    Item -> Engine: Remove item from the screen
    Engine -> Player: Energy bar increases
end

'player wins the game (longboi is returned and make the bus):'

alt Player has LongBoi and Time != 0
    Player -> Player: Reach exit (bus)
    Player -> Enemy: Distract Dean Enemy with Long Boi Statue in inventory
    Engine -> Player: Display that the player has won and show score
else Player doesn't have LongBoi or time = 0
    Engine -> Player: Game over
end

@enduml
